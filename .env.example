# ---------------------------------------------------------------------------
# PostgreSQL 连接参数
# 使用方式：复制本文件为 .env，再填入真实值
#   cp .env.example .env
# ---------------------------------------------------------------------------

# 数据库主机（本地用 localhost，远程填 IP 或域名）
DB_HOST=localhost

# 数据库端口，PostgreSQL 默认 5432
DB_PORT=5432

# 数据库名称
DB_NAME=fb_scraper

# 数据库用户名
DB_USER=fb_app

# 数据库密码
# 注意：值中含有 # 或空格时，必须用双引号包裹，例如 DB_PASSWORD="p@ss#word"
DB_PASSWORD=change_me

# SSL 模式：disable / allow / prefer / require / verify-ca / verify-full
# 本机开发可用 prefer；连远程生产库建议用 require
DB_SSLMODE=prefer

# 建立连接的超时秒数
DB_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Apify 抓取参数
# ---------------------------------------------------------------------------
APIFY_API_KEY="apify_api_bM3qsQxxxxxxxxxxxxxxxxxx"

# Actor ID（默认 getanyapi/facebook-group-posts-scraper）
# APIFY_ACTOR=getanyapi/facebook-group-posts-scraper

# 单次抓取的贴文上限（默认 30）
# APIFY_MAX_ITEMS=30

# ---------------------------------------------------------------------------
# 同步行为（皆可省略使用默认值）
# ---------------------------------------------------------------------------
# 每轮同步之间的等待秒数（默认 120）
# FB_SYNC_INTERVAL_SECONDS=120

# 社团清单（JSON，省略则使用程序内置的默认社团）
# FB_GROUP_MAP_JSON={"133186676696605": "电脑零件买卖集中营"}

# ---------------------------------------------------------------------------
# 跨社团去重参数（默认值见 fb_robot.config.DedupSettings）
# ---------------------------------------------------------------------------
# SimHash 距离阈值，越小越严格（默认 3）
# FB_DEDUP_SIMHASH_MAX_DISTANCE=3
# 比对的回溯天数（默认 30）
# FB_DEDUP_LOOKBACK_DAYS=30
# 每位作者比对的候选贴上限（默认 200）
# FB_DEDUP_LOOKBACK_LIMIT=200
# ---------------------------------------------------------------------------
# LLM 貼文分類（fb-robot classify，本地 OpenAI 相容端點；設計見 docs/classification-design.md）
# 只有 FB_LLM_MODEL 必填，其餘省略即用預設值
# ---------------------------------------------------------------------------
# 端點上的模型名稱（例：LM Studio / vLLM / Ollama 列出的 model id）
# FB_LLM_MODEL=your-local-model
# FB_LLM_API_BASE=http://localhost:1234/v1
# FB_LLM_API_KEY=local

# 結構化輸出：json_schema（預設）/ json_object / none（端點不支援 response_format 時用）
# FB_LLM_RESPONSE_FORMAT=json_schema

# FB_LLM_TEMPERATURE=0
# FB_LLM_MAX_TOKENS=1500
# FB_LLM_TIMEOUT_SECONDS=120
# FB_LLM_PROMPT_VERSION=v1
# 低於此信心的項目標記為待複核
# FB_LLM_MIN_CONFIDENCE=0.6
# 貼文本文截斷上限字元數
# FB_LLM_MAX_CHARS=4000
